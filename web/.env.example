# Copy to .env.local for local use. Never commit .env.local.
# On Azure: set these as Container App Secrets + Environment Variables (docs/AZURE.md).

# Random secret that signs the login cookie (min. 32 characters).
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Admin account (bootstrap / break-glass). Additional users and roles live in the database.
ADMIN_EMAIL=wilman@transmare.com
ADMIN_NAME=Willem Manssens
# Make with: npm run hash-password
ADMIN_PASSWORD_HASH=

# Database: Azure Database for PostgreSQL (uses standard pg with verified TLS).
# Leave empty on a laptop: the app uses a built-in database (.data/pglite).
DATABASE_URL=

# File storage backend selector:
#   azure-blob  -> Azure Blob Storage via passwordless Entra Managed Identity (ready now)
#   sharepoint  -> SharePoint document library via Microsoft Graph (Sites.Selected)
#   local       -> laptop only (.data/files); refused in production
# Leave unset to auto-select: SharePoint -> Azure Blob -> local (non-prod only).
STORAGE_BACKEND=azure-blob

# Azure Blob Storage (passwordless Entra Managed Identity; no shared access keys or SAS):
AZURE_STORAGE_ACCOUNT=tmcdoccenterstorage
AZURE_STORAGE_CONTAINER=documents
# User-Assigned Managed Identity client ID (e.g. tmc-doccenter-id):
AZURE_CLIENT_ID=

# SharePoint document library via Microsoft Graph (Sites.Selected Write on one site).
# Switch from test site (TMCDOCUMENTCENTER) to live DMS in January by changing SITE_ID/DRIVE_ID only.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
# Set SHAREPOINT_DRIVE_ID (fastest) or SHAREPOINT_SITE_ID (resolves the default Documents library):
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
# Optional folder layout overrides (defaults work out of the box):
# SHAREPOINT_STORAGE_FOLDER=_app-storage
# SHAREPOINT_ORDERS_ROOT=
# SHAREPOINT_OUTPUT_SUBFOLDER=
# SHAREPOINT_GENERAL_FOLDER=General

# Wake-up call from web to worker (Azure Container Apps internal URL). Optional on a laptop.
WORKER_WAKE_URL=
WORKER_WAKE_SECRET=

# AI reader (worker only, never set ANTHROPIC_API_KEY on web). Off unless AI_READER=on.
# The key comes from TMC's Anthropic account (dedicated workspace with spend cap); never in git or chat.
AI_READER=
ANTHROPIC_API_KEY=
AI_READER_MODEL=claude-opus-5-5
AI_READER_EFFORT=medium
AI_READER_MAX_CALLS=3
AI_READER_DAILY_CALLS=30
AI_READER_TIMEOUT_S=120

# API v1 for TMC Logistics (docs/API.md). Off unless API_CLIENTS_ENABLED=on. APP_URL is this
# app's own address, used for the links in API answers (https, or http://localhost on a laptop).
# DC_API_MAX_BODY_MB: defaults to 100 on Azure (clamped 1..100).
# Keys are made by an admin under Settings > API keys; only their SHA-256 is stored.
API_CLIENTS_ENABLED=
APP_URL=
# DC_API_MAX_BODY_MB=100
