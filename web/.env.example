# Copy to .env.local for local use. Never commit .env.local.
# On Azure: Container App Secrets + Environment Variables. On Vercel: Project > Settings > Env.

# Random secret that signs the login cookie (min. 32 characters).
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Phase 0: one admin account. Users and roles move to the database in phase 1.
ADMIN_EMAIL=wilman@transmare.com
ADMIN_NAME=Willem Manssens
# Make with: npm run hash-password
ADMIN_PASSWORD_HASH=

# Database: Azure Database for PostgreSQL (uses pg + TLS) or Neon Postgres (*.neon.tech).
# Leave empty on a laptop: the app uses a built-in database (.data/pglite).
# Optional override: DATABASE_DRIVER=pg or neon.
DATABASE_URL=
# DATABASE_DRIVER=

# File storage: SharePoint (Azure) OR Vercel Blob (Vercel). Leave both empty on a laptop (.data/files).
# Vercel Blob (pilot only):
BLOB_READ_WRITE_TOKEN=

# Phase 4a: SharePoint document library via Microsoft Graph (Sites.Selected Write on one site).
# Switch from test site (TMCDOCUMENTCENTER) to live DMS in January by changing SITE_ID/DRIVE_ID only.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
# Set SHAREPOINT_DRIVE_ID (fastest) or SHAREPOINT_SITE_ID (resolves the default Documents library):
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
# Optional folder layout overrides (defaults work out of the box):
# SHAREPOINT_STORAGE_FOLDER=_app-storage
# SHAREPOINT_ORDERS_ROOT=
# SHAREPOINT_OUTPUT_SUBFOLDER=
# SHAREPOINT_GENERAL_FOLDER=General

# Phase 2: wake-up call to the worker (Azure Container Apps internal URL or Railway). Optional on a laptop.
WORKER_WAKE_URL=
WORKER_WAKE_SECRET=

# AI reader (27/10/2026), worker only. Off unless AI_READER=on. The key comes from TMC's
# Anthropic account (a separate workspace with its own spend limit); never in git or chat.
# Start values for the measurement: effort medium, 3 calls per run, 30 per day, 120 s.
AI_READER=
ANTHROPIC_API_KEY=
AI_READER_MODEL=claude-opus-5-5
AI_READER_EFFORT=medium
AI_READER_MAX_CALLS=3
AI_READER_DAILY_CALLS=30
AI_READER_TIMEOUT_S=120

# API v1 for TMC Logistics (docs/API.md). Off unless API_CLIENTS_ENABLED=on. APP_URL is this
# app's own address, used for the links in API answers (https, or http://localhost on a laptop).
# DC_API_MAX_BODY_MB: 4 on Vercel, up to 100 on Azure.
# Keys are made by an admin under Settings > API keys; only their SHA-256 is stored.
API_CLIENTS_ENABLED=
APP_URL=
# DC_API_MAX_BODY_MB=100
